{
  "name": "snail-runner",
  "version": "0.1.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/verify-mattes.mjs && node --import ./scripts/register-ts-loader.mjs scripts/verify-palettes.mjs && node scripts/check-bundle.mjs",
    "bundle": "npm run build && node scripts/make-bundle.mjs",
    "preview": "vite preview",
    "verify:scroll": "node --import ./scripts/register-ts-loader.mjs scripts/verify-scroll-momentum.mjs",
    "verify:road": "node --import ./scripts/register-ts-loader.mjs scripts/verify-road-projection.mjs",
    "verify:run-speed": "node --import ./scripts/register-ts-loader.mjs scripts/verify-run-speed.mjs",
    "verify:suspend": "node --import ./scripts/register-ts-loader.mjs scripts/verify-suspend.mjs",
    "verify:player": "node --import ./scripts/register-ts-loader.mjs scripts/verify-player.mjs",
    "verify:jump": "node --import ./scripts/register-ts-loader.mjs scripts/verify-jump.mjs",
    "verify:tutorial": "node --import ./scripts/register-ts-loader.mjs scripts/verify-tutorial.mjs",
    "verify:obstacles": "node --import ./scripts/register-ts-loader.mjs scripts/verify-obstacles.mjs",
    "verify:critters": "node --import ./scripts/register-ts-loader.mjs scripts/verify-critters.mjs",
    "verify:audio": "node --import ./scripts/register-ts-loader.mjs scripts/verify-audio.mjs",
    "verify:quests": "node --import ./scripts/register-ts-loader.mjs scripts/verify-quests.mjs",
    "verify:ads": "node scripts/verify-ads.mjs",
    "verify:scoring": "node --import ./scripts/register-ts-loader.mjs scripts/verify-scoring.mjs",
    "verify:ui": "node --import ./scripts/register-ts-loader.mjs scripts/verify-ui.mjs",
    "verify:mattes": "node scripts/verify-mattes.mjs",
    "art:ui": "py -3.11 scripts/normalize-ui.py --sheet",
    "art:critter": "py -3.11 scripts/normalize-critter.py",
    "verify:sightline": "node --import ./scripts/register-ts-loader.mjs scripts/verify-sightline.mjs",
    "verify:fever": "node --import ./scripts/register-ts-loader.mjs scripts/verify-fever.mjs",
    "verify:formations": "node --import ./scripts/register-ts-loader.mjs scripts/verify-formations.mjs",
    "verify:ramp": "node --import ./scripts/register-ts-loader.mjs scripts/verify-ramp.mjs",
    "verify:platform": "node --import ./scripts/register-ts-loader.mjs scripts/verify-platform.mjs",
    "verify:menu": "node --import ./scripts/register-ts-loader.mjs scripts/verify-menu.mjs",
    "verify:layout": "node --import ./scripts/register-ts-loader.mjs scripts/verify-layout.mjs",
    "verify:skins": "node --import ./scripts/register-ts-loader.mjs scripts/verify-skins.mjs",
    "verify:palettes": "node --import ./scripts/register-ts-loader.mjs scripts/verify-palettes.mjs"
  },
  "dependencies": {
    "phaser": "^4.2.0"
  },
  "devDependencies": {
    "archiver": "^8.0.0",
    "typescript": "^5.5.3",
    "vite": "^6.0.0"
  },
  "private": true
}
